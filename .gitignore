
# ==================================
# 默认忽略所有文件
# ==================================
*

# 允许 Git 遍历子文件夹
!*/

# ==================================
# 只保留 Python 源代码
# ==================================
!*.py

# 保留 Git 忽略规则文件
!.gitignore

# ==================================
# 排除不需要上传的目录
# ==================================

# Python 缓存
__pycache__/
.pytest_cache/

# Python 虚拟环境
venv/
.venv/
env/
conda-env/
site-packages/

# 训练日志
logs/
runs/
wandb/

# 模型权重
pretrained/
checkpoints/
weights/

# 数据集与实验结果
datasets/
data/
outputs/
results/
